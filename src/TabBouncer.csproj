<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tabbouncer</AssemblyName>
    <Version>1.1.0</Version>
    <Product>TabBouncer</Product>
    <Description>Closes automatic ad tabs and popups in a dedicated Chrome window while keeping the tabs you opened.</Description>
    <Copyright>Copyright (c) 2026 Choi HeungBae</Copyright>
    <RootNamespace>TabBouncer</RootNamespace>
    <ApplicationIcon>tabbouncer.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <BaseOutputPath>..\bin\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="tabbouncer.ico" LogicalName="TabBouncer.tabbouncer.ico" />
    <!-- 화면 문구 표. 실행 파일에 넣은 사본은 옆 파일이 없을 때를 대비한 것이고, 옆 파일이 있으면 그 내용이 우선한다. -->
    <EmbeddedResource Include="languages.json" LogicalName="TabBouncer.languages.json" />
    <None Update="languages.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <!-- 배포본에는 넣지 않는다. 새 버전을 기존 폴더에 덮어써도 사용자 config.json이 유지되고, 없으면 첫 실행 때 만든다. -->
    <None Update="config.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
